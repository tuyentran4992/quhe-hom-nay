APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB — MariaDB 10.11 (spec 01 §5, 02-db): queue+sessions đều qua database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quhe_hom_nay
DB_USERNAME=quhe_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI-Box (reader: giá trị AIBOX_API_KEY KHÔNG commit — cấp qua env deploy/local)
AIBOX_API_KEY=
AIBOX_BASE_URL=https://api.example-aibox.test/v1
AIBOX_MODEL=aibox-default
# BUG-V3-1 (card t_05d92158): model PHÂN LOẠI danh mục — BẮT BUỘC non-reasoning.
# Model reasoning nhét nhãn sau lý lẽ → max_tokens router (8) bị ăn hết, content
# rỗng, mọi bài rơi nhánh fallback. Đã probe thật 01/09: qwen3.6-flash đúng nhãn.
AIBOX_ROUTER_MODEL=qwen3.6-flash

# payOS (sóng 2 — placeholder rỗng theo spec 01 §5)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_SECRET=

# [MKT-F2b] Landing Blade GET / (specs/1.mvp/06-mkt-tracking.md §1)
# Link OA/Zalo cho khối "Theo dõi trên Zalo" — rỗng → href fallback '#' (testid landing-link-oa).
LANDING_OA_URL=
# GA4 Measurement ID (dạng G-XXXXXXXXXX) — rỗng → blade KHÔNG render snippet gtag.
GA4_MEASUREMENT_ID=

# [FREE-DEEP t_50ce8d85] Gate luận sâu — reader: backend/config/preview.php, mặc định TẮT nếu thiếu dòng này.
# true  = luận sâu FREE cho mọi device (chế độ pilot 02/09, luật anh Tuyền 31/08) — vẫn giữ cooldown/cap/idempotency.
# false = paywall 29k nguyên bản đã QA (402 khi chưa paid). DEPLOY PILOT: PHẢI SET TRUE — quên = bật paywall trái luật.
FREE_DEEP_PREVIEW=false
